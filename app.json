{
  "expo": {
    "name": "AgoraWebViewTest",
    "slug": "agorawebviewtest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agorawebviewtest",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow this app to access the camera for real-time video streaming.",
        "NSMicrophoneUsageDescription": "Allow this app to access the microphone for real-time voice streaming.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.avenger1234.AgoraWebViewTest"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "jdkVersion": "17",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.avenger1234.AgoraWebViewTest"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow this app to access the camera for real-time video streaming.",
          "microphonePermission": "Allow this app to access the microphone for real-time voice streaming."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c251375-434d-41ef-a133-a617b82480e9"
      }
    },
    "owner": "avenger1234s-organization"
  }
}
